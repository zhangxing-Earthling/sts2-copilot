<Window x:Class="Sts2Copilot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StS2 Copilot" Height="800" Width="580"
        Topmost="True"
        Background="{StaticResource Bg}"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock Text="StS2 Copilot" FontSize="19" FontWeight="SemiBold"
                       Foreground="{StaticResource Text}" VerticalAlignment="Center" />
            <TextBlock Text="内存只读" Margin="10,0,0,0" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" />
            <Button Content="重新连接" Click="ConnectButton_Click" Margin="16,0,0,0" />
            <CheckBox Content="置顶" IsChecked="True" Margin="12,0,0,0"
                      Checked="Topmost_Changed" Unchecked="Topmost_Changed" />
            <TextBlock x:Name="StatusText" Text="未连接" Margin="14,0,0,0"
                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="RunText" Text="等待进入对局…" Foreground="{StaticResource Muted}" />
                    <TextBlock x:Name="HpText" Text="---" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Margin="0,6,0,0" />
                    <TextBlock x:Name="EnergyText" Text="" FontSize="15"
                               Foreground="#F0C674" Margin="0,4,0,0" />

                    <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />
                    <TextBlock Text="手牌" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="HandText" Text="---" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#D8E0EA" LineHeight="24" />

                    <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />
                    <TextBlock Text="敌人" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="EnemyText" Text="---" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#F0A0A0" LineHeight="24" />

                    <Separator x:Name="MapSeparator" Margin="0,14,0,10" Background="{StaticResource Line}" Visibility="Collapsed" />
                    <TextBlock x:Name="MapLabel" Text="地图" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Visibility="Collapsed" />
                    <TextBlock x:Name="MapText" Text="" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#A8C8F0" LineHeight="24" Visibility="Collapsed" />

                    <Separator x:Name="RewardSeparator" Margin="0,14,0,10" Background="{StaticResource Line}" Visibility="Collapsed" />
                    <TextBlock x:Name="RewardLabel" Text="奖励" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}" Visibility="Collapsed" />
                    <TextBlock x:Name="RewardText" Text="" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#B8E0A0" LineHeight="24" Visibility="Collapsed" />

                    <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />
                    <TextBlock Text="建议" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                    <TextBlock x:Name="AdviceText" Text="---" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="#F0C674" FontSize="15" LineHeight="24" />

                    <Separator Margin="0,14,0,10" Background="{StaticResource Line}" />
                    <TextBlock x:Name="MiscText" Text="" TextWrapping="Wrap"
                               Foreground="{StaticResource Muted}" LineHeight="21" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="2" x:Name="LogText" Text="就绪"
                   Margin="2,10,0,0" Foreground="{StaticResource Muted}" FontSize="12" />
    </Grid>
</Window>
